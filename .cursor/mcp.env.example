# Copy to mcp.env (gitignored) or set as system/user environment variables.
# Restart Cursor after changing env vars.

# GitHub — https://github.com/settings/tokens (repo, read:org, etc. as needed)
GITHUB_PERSONAL_ACCESS_TOKEN=

# Context7 — https://context7.com/dashboard (optional but higher rate limits)
CONTEXT7_API_KEY=

# Postman — https://go.postman.co/settings/me/api-keys
POSTMAN_API_KEY=
